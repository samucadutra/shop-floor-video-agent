# Copy to .env and adjust. Never commit .env.
# Full list and descriptions: docs/spec.md S14. Variables are added here as each phase uses them.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
MEDIA_ROOT=/app/media
LOG_LEVEL=INFO

# --- Upload limits ---
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=130

# --- Database (DATABASE_URL must match the POSTGRES_* values) ---
POSTGRES_DB=shopfloor
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@postgres:5432/shopfloor

# --- Redis (Celery broker) ---
REDIS_URL=redis://redis:6379/0

# --- LLM provider: gemini (default in code) or mock (no API key, offline) ---
LLM_PROVIDER=mock
# Secret, from Google AI Studio (free, no billing). Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
# A free tier Flash or Flash-Lite model. Required when LLM_PROVIDER=gemini. Check the AI Studio model list.
GEMINI_MODEL=gemini-flash-latest
# Timeout per LLM call (seconds)
LLM_TIMEOUT_SECONDS=60
# Backoff retries on 429/5xx/timeouts (a daily quota error is never retried)
LLM_MAX_RETRIES=3
# Throttle: max LLM requests in any 60 s (keep under the free tier limit)
LLM_MAX_REQUESTS_PER_MINUTE=8

# --- Analysis run and frame extraction ---
# Celery soft time limit for one run (seconds)
AGENT_RUN_TIMEOUT_SECONDS=600
# Survey frame interval (seconds)
SURVEY_INTERVAL_S=2
# ffmpeg scene change score (0-1)
SCENE_THRESHOLD=0.4
# Resize frames so the long side is at most this many pixels
FRAME_MAX_SIDE=768
# Frame rate inside the windows the agent inspects
INSPECT_FPS=2
# Seconds around a candidate when building a window
WINDOW_PADDING_S=2

# --- Agent ---
# Event type config, relative to backend/
EVENT_TYPES_FILE=agent/event_types.yaml
# Max images per LLM call
FRAMES_PER_CALL=12
# Min confidence to keep an event
CONFIDENCE_THRESHOLD=0.6
# Guardrails per run
AGENT_MAX_ITERATIONS=3
AGENT_MAX_FRAMES=120
AGENT_MAX_TOKENS=200000
# No effect while the prices below are 0
AGENT_MAX_COST_USD=0.50
AGENT_MAX_LLM_CALLS=20
# Tokens kept back so the report can always be written
AGENT_REPORT_RESERVE_TOKENS=4000
# USD per 1M tokens, for the cost estimate (0 on the free tier)
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0
# Mock provider delay per call (0 in tests)
MOCK_LATENCY_MS=300

# --- Frontend (build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
